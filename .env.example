# RoboTrack environment variables
# Copy this file to .env and fill in your own values.

# MongoDB Atlas connection string (free M0 cluster is enough)
# Atlas -> Cluster -> Connect -> Drivers -> copy the URI, then:
#   1. replace <password> with your database user's password
#   2. keep /robotrack as the database name
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/robotrack?retryWrites=true&w=majority

# Port for the web server (frontend + API)
PORT=3000

# Base URL the simulator uses to reach the API.
# Leave as default when running everything on one machine.
API_URL=http://localhost:3000
